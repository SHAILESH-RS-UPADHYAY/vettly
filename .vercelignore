# Only the app is uploaded: api/, backend/, web/ and the root config files

# Your data stays off Vercel: the hosted app starts every account empty
backend/context_store/*.json
!backend/context_store/context.example.json
backend/uploads/
backend/recordings/

# Secrets never ship with the code (Vercel holds its own environment variables)
**/.env
**/.env.*
!**/.env.example

# Not needed to run the app
docs/
scripts/
.github/
.private/
.playwright-mcp/
.hallmark/
