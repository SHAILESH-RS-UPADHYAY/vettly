# Personal data stays off Vercel: the hosted demo starts with an empty profile
backend/context_store/*.json
!backend/context_store/context.example.json
backend/uploads/
backend/recordings/

# Local tooling
.playwright-mcp/
.hallmark/
*.bat

# Secrets never ship with the code (Vercel holds its own env vars)
**/.env
**/.env.*
!**/.env.example
