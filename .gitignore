# ── Secrets: never committed ──
# Real keys live in backend/.env (copy backend/.env.example); `vercel env pull` writes .env.* files
.env
.env.*
!.env.example

# ── Your data stays on your machine ──
# The local stores (profile, chats, answers), uploaded resumes and recordings
backend/context_store/*.json
!backend/context_store/context.example.json
backend/context_store/users/
backend/uploads/
backend/recordings/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# ── Logs ──
*.log

# ── Editors, OS and local tools ──
.DS_Store
Thumbs.db
.vscode/
.idea/
.vercel/
.claude/
.hallmark/
.playwright-mcp/

# ── Private notes and tracking: never pushed or deployed ──
.private/
