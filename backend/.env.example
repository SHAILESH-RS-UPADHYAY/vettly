# ═══════════════════════════════════════════════════════════════
# Vettly — Multi-Provider AI Career & Prep Studio Configuration
# ═══════════════════════════════════════════════════════════════
# Configure ANY ONE (or more) of the 3 LLM options below.
# Priority order: 1. Claude (Anthropic) -> 2. Gemini -> 3. Groq
# ═══════════════════════════════════════════════════════════════

# OPTION 1: Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OPTION 2: Google Gemini API — 100% Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPTION 3: Groq Cloud API — 100% Free Tier (https://console.groq.com)
# (Use a fresh Groq key here — do NOT reuse Acemate's key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deepgram Voice / STT Engine (https://console.deepgram.com)
# (Use your separate Deepgram key here for Vettly voice features)
DEEPGRAM_API_KEY=

# GitHub Personal Access Token (Optional — increases repo fetch rate limit)
GITHUB_TOKEN=

# Server Settings
HOST=127.0.0.1
PORT=8766

# LLM Generation Settings
ANSWER_MAX_TOKENS=350
TEMPERATURE=0.7
DEFAULT_LANGUAGE=en
HINGLISH_MODE=auto
