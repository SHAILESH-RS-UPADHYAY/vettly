# ─────────────────────────────────────────────────────────────────────────────
# Vettly settings
#
# Local (just you): copy this file to backend/.env and add one AI key. No sign-in;
#   your data stays in backend/context_store/.
# Hosted (Vercel): set these under Settings → Environment Variables instead. The
#   Clerk and Neon integrations add their own keys.
#
# A line that starts with # is optional: remove the # to change its default.
# backend/.env is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────


# ── AI providers ─────────────────────────────────────────────────────────────
# One key is enough. Vettly tries the free tiers first (Gemini, then Groq, then
# Claude, then OpenAI) and moves on when one is busy.
# Each key can be a pool, comma separated (key1,key2,key3): the router takes
# turns across them.

# Google AI Studio, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic, paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI, paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Models. The defaults work on the free tiers.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# The Mentor. On a paid key, gemini-pro-latest follows the newest Pro release.
# GEMINI_BOT_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-4o-mini


# ── Answers ──────────────────────────────────────────────────────────────────
# ANSWER_MAX_TOKENS=350
# FILLER_MAX_TOKENS=100
# TEMPERATURE=0.7
# DEFAULT_LANGUAGE=en
# Hinglish answers: auto (follow the question), always or never
# HINGLISH_MODE=auto


# ── Other services (optional) ────────────────────────────────────────────────
# Live Copilot's speech to text: https://console.deepgram.com
DEEPGRAM_API_KEY=
# Reading your GitHub repos. A token lifts the rate limit; public repos need no scopes.
GITHUB_TOKEN=


# ── Running locally ──────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8766
# Open the browser when the server starts (1 = yes)
# AUTO_OPEN_BROWSER=1
# Restart when the code changes (1 = yes)
# RELOAD=0
# Microphone audio for the Live Copilot (rarely changed)
# SAMPLE_RATE=16000
# CHANNELS=1
# CHUNK_DURATION_MS=30


# ── Hosted, multi-user (Vercel) ──────────────────────────────────────────────
# Leave these empty locally. On Vercel the integrations set them (they may use the
# names NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and POSTGRES_URL; both are read).

# Sign-in (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sites allowed to sign in, comma separated (e.g. https://vettly.app)
CLERK_AUTHORIZED_PARTIES=

# Database (Neon Postgres). Empty = JSON files in backend/context_store/
DATABASE_URL=

# Other sites allowed to call the API (CORS), comma separated. Empty = same site only
ALLOWED_ORIGINS=

# Encrypts the AI keys people save for themselves: any long random string.
# Empty = saving your own keys is switched off.
KEY_ENCRYPTION_SECRET=

# Free AI answers per person per day, and one daily cap for everyone together
# FREE_DAILY_AI=25
# GLOBAL_DAILY_AI=2000
